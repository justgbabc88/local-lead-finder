# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key     # server-side only; NEVER ship to frontend
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret            # from Supabase > Settings > API

# Google Places API (Phase 1: single key used as fallback if the api_keys_google pool is empty)
GOOGLE_PLACES_API_KEY=your-google-places-key

# Redis (Phase 2+)
REDIS_URL=redis://localhost:6379/0
SCRAPE_QUEUE_NAME=scrape_tasks
ENRICHMENT_QUEUE_NAME=enrichment_tasks
WORKER_JOB_TIMEOUT=900

# CORS
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# App
LOG_LEVEL=info
